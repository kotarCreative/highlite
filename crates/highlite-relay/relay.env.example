# Copy to relay.env, replace the secrets, and run:
#   highlite-relay --env-file ./relay.env

# HTTP listener and storage.
HIGHLITE_RELAY_BIND=127.0.0.1:8787
HIGHLITE_RELAY_DATA_DIR=./highlite-relay-data

# Auth. Comma-separate values to rotate without downtime.
HIGHLITE_RELAY_INGEST_TOKEN=replace-with-a-long-ingest-token
HIGHLITE_RELAY_READ_TOKEN=replace-with-a-long-read-token

# Exact Host headers and browser origins. Include the port when it is present.
HIGHLITE_RELAY_ALLOWED_HOSTS=127.0.0.1:8787
HIGHLITE_RELAY_ALLOWED_ORIGINS=http://localhost:5173

# Limits and compile concurrency.
HIGHLITE_RELAY_MAX_UPLOAD_MB=64
HIGHLITE_RELAY_MAX_UNCOMPRESSED_MB=256
HIGHLITE_RELAY_MAX_FILES=2000
HIGHLITE_RELAY_CONCURRENCY=2
HIGHLITE_RELAY_KEEP_UPLOADS=false

# Optional relay-side transcription. The command receives the audio path.
# HIGHLITE_RELAY_TRANSCRIBER_COMMAND=python3 /srv/highlite/asr.py
# HIGHLITE_RELAY_LANGUAGE=en

# Compiler and rendered-bundle settings. Unset values use compiler defaults;
# MAX_KEYFRAMES overrides the duration-based budget (6-12 frames).
# HIGHLITE_RELAY_MAX_KEYFRAMES=8
# HIGHLITE_RELAY_MIN_GAP_MS=500
# HIGHLITE_RELAY_CLAUSE_GAP_MS=1500
# HIGHLITE_RELAY_CROP_PADDING_PX=24
# HIGHLITE_RELAY_CROP=true
# HIGHLITE_RELAY_COVERAGE=true
# HIGHLITE_RELAY_SPEECH_CUES=true
# HIGHLITE_RELAY_CUE_WINDOW_MS=1200
# HIGHLITE_RELAY_BURN_ANNOTATIONS=true
# HIGHLITE_RELAY_CONTACT_SHEET=true
# HIGHLITE_RELAY_CONTACT_SHEET_WIDTH=1600

# Optional signed completion webhook.
# HIGHLITE_RELAY_WEBHOOK_URL=https://consumer.example.com/hooks/highlite
# HIGHLITE_RELAY_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# HIGHLITE_RELAY_WEBHOOK_TIMEOUT_SECONDS=5
# HIGHLITE_RELAY_WEBHOOK_ATTEMPTS=3
