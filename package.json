{
  "name": "highlite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "build": "pnpm -r --sort build",
    "dev": "pnpm build && pnpm --filter @highlite/demo dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && node scripts/browser-smoke.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
