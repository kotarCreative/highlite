{
  "name": "highlite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "build": "pnpm -r --sort build",
    "dev": "pnpm build && pnpm --filter @highlite/demo dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && node scripts/browser-smoke.mjs && pnpm build:rust && node scripts/compiler-e2e.mjs",
    "test:compiler:e2e": "pnpm build && pnpm build:rust && node scripts/compiler-e2e.mjs",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "check:rust": "pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "build:rust": "cargo build --workspace --release",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:rust"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
